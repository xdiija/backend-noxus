APP_NAME="Controle Financeiro"
APP_URL=http://localhost:8989
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=root

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
BROADCAST_DRIVER=log
FILESYSTEM_DISK=local
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# MinIO (S3-compatible). Credentials double as the MinIO root user/password
# (see docker-compose minio service).
AWS_ACCESS_KEY_ID=noxus
AWS_SECRET_ACCESS_KEY=noxus_secret_123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=noxus-animals
AWS_USE_PATH_STYLE_ENDPOINT=true
# Endpoint the app (PHP container) uses to reach MinIO over the docker network.
AWS_ENDPOINT=http://minio:9000
# Endpoint baked into presigned URLs handed to the browser (must be reachable
# from the user's machine; SigV4 signs this host).
AWS_ENDPOINT_PUBLIC=http://localhost:9000

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
